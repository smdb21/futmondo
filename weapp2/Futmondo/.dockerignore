# Allow production app files, the worker service, and named build checks only.
**
!/*.R
!/Modules/
!/Modules/*.R
!/worker/
!/worker/**
!/www/
!/www/**
!/player_columns_to_hide.txt
!/shiny-server.conf
!/scripts/
/scripts/**
!/scripts/patch-shiny-reconnect.cjs
!/test/
/test/**
!/test/test_shiny_reconnect.cjs

# Never bundle credentials, captures, local state, or obsolete source backups.
**/.env*
**/.Renviron*
**/.Rprofile
**/.Rhistory
**/.RData*
**/*.har
**/*.orig
**/*.pem
**/*.key
**/*credentials*.json

**/__pycache__
**/*.pyc
**/.venv
